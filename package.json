{
  "name": "back-track",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Back track, an interactive music ancestry explorer.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "dev:backend": "node --env-file-if-exists=.env --watch backend/server.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env backend/server.js",
    "test": "node --test tests/*.test.js backend/tests/*.test.js",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "express": "^5.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
